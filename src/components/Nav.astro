---
import ResumeMenu from './ResumeMenu.astro';

const navItems = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Writing', href: '/blog/' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg">
  <div
    class="wrap flex flex-wrap items-center gap-x-7 gap-y-3 py-3.5 sm:py-4"
  >
    <a
      href="/"
      class="mr-auto font-serif text-lg tracking-tight text-text transition-colors duration-200 hover:text-accent sm:text-xl"
    >
      Rushi Kohak
    </a>

    <nav aria-label="Primary" class="flex items-center gap-5 sm:gap-6">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="meta transition-colors duration-200 hover:text-text"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ResumeMenu />
  </div>
</header>
