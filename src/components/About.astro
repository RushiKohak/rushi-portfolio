---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const { about } = site;
---

<Section id="about">
  <SectionHeading eyebrow="About" title={about.heading} />

  <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-20">
    <div class="reveal measure flex flex-col gap-5 text-muted">
      {about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <dl
      class="reveal border-t border-border"
      style="--reveal-delay: 120ms"
    >
      {
        about.facts.map((fact) => (
          <div class="border-b border-border py-4">
            <dt class="meta">{fact.label}</dt>
            <dd class="mt-1.5 text-sm leading-snug text-text">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
