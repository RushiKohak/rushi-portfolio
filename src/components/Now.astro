---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const { now } = site;
---

<Section id="now">
  <SectionHeading eyebrow="Now" title="At the moment" intro={now.intro} />

  <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-20">
    <dl class="reveal border-t border-border">
      {
        now.items.map((item) => (
          <div class="grid gap-1 border-b border-border py-5 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-8">
            <dt class="meta sm:pt-1">{item.label}</dt>
            <dd class="measure text-sm leading-relaxed text-muted">{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="reveal meta lg:text-right" style="--reveal-delay: 120ms">
      {now.updated}
    </p>
  </div>
</Section>
