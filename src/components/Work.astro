---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<Section id="work">
  <SectionHeading
    eyebrow="Selected work"
    title="Three things I built end to end"
    intro="Each one started with a question I couldn't answer from a tutorial. The case studies cover what broke, what I changed, and what I'd do differently."
  />

  <div class="mt-14 flex flex-col gap-14">
    {
      featured.map((project, i) => (
        <FeaturedProject project={project} index={String(i + 1).padStart(2, '0')} />
      ))
    }
  </div>
</Section>

{
  rest.length > 0 && (
    <Section id="more-work">
      <SectionHeading
        eyebrow="Also worth a look"
        title="Smaller builds"
        intro="Shorter projects, same habit of finishing them."
      />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </Section>
  )
}
