---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const { skills } = site;
---

<Section id="skills">
  <SectionHeading
    eyebrow="Toolkit"
    title="What I reach for"
    intro={skills.intro}
  />

  <dl class="reveal mt-12 border-t border-border">
    {
      skills.groups.map((group) => (
        <div class="grid gap-2 border-b border-border py-5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-8">
          <dt class="meta sm:pt-1">{group.label}</dt>
          <dd class="text-sm leading-relaxed text-text">
            {group.items.join('  ·  ')}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
