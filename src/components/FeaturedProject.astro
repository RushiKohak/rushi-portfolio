---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: string;
}

const { project, index } = Astro.props;
const { title, summary, domain, year, stack } = project.data;
---

<article
  class="group relative grid gap-4 border-t border-border pt-8 sm:grid-cols-[3rem_1fr] sm:gap-8"
>
  <p class="meta pt-2 tabular-nums">{index}</p>

  <div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
      <h3 class="text-[1.75rem] leading-[1.15] sm:text-[2.125rem]">
        <a
          href={`/work/${project.id}/`}
          class="text-text transition-colors duration-200 after:absolute after:inset-0 hover:text-accent group-hover:text-accent"
        >
          {title}
        </a>
      </h3>
      <p class="meta">{domain} · {year}</p>
    </div>

    <p class="measure mt-3 leading-[1.65] text-muted">{summary}</p>

    <p class="meta mt-4 normal-case tracking-normal">{stack.join('  ·  ')}</p>

    <p
      class="mt-5 inline-flex items-center gap-2 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-text transition-colors duration-200 group-hover:text-accent"
    >
      Read the case study
      <span
        class="inline-block transition-transform duration-200 group-hover:translate-x-1"
        aria-hidden="true">→</span
      >
    </p>
  </div>
</article>
