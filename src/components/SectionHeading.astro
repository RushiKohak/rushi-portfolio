---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="max-w-3xl">
  <p class="meta eyebrow">{eyebrow}</p>
  <h2 class="mt-4 text-h2">{title}</h2>
  {intro && <p class="measure mt-4 text-muted">{intro}</p>}
</div>
